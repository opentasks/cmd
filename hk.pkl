amends "package://github.com/jdx/hk/releases/download/v1.25.0/hk@1.25.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.25.0/hk@1.25.0#/Builtins.pkl"

// ===============================================
// Security-Focused Git Hooks for OpenTasks
// ===============================================
//
// Configured checks:
// - Secret detection (gitleaks)
// - Go security scanning (gosec)
// - Code quality (merge conflicts, private keys, trailing whitespace)
// - Go formatting (gofmt, goimports)
//
// Note: govulncheck excluded from pre-commit (too slow, run manually or in CI)
//
// To activate: uncomment the hooks sections below
// Then run: mise exec -- hk install
//
// See .memory/guide-002-hk-security-setup.md for full instructions
// ===============================================

local security_linters = new Mapping<String, Step> {
    // Secret detection - blocks commits with API keys, tokens, passwords
    ["gitleaks"] {
        glob = "*"
        check = "gitleaks detect --source . --no-git --exit-code 1"
    }

    // Go security scanning - custom (builtin passes individual files, gosec needs directories)
    // Excludes G204 (subprocess) - acceptable for CLI tools (e.g., $EDITOR launch)
    // G304 (file inclusion) uses selective #nosec comments with justification
    ["gosec"] {
        glob = "**/*.go"
        check = "gosec -exclude=G204 ./..."
    }

    // Note: govulncheck removed from pre-commit (slow, better suited for CI)
    // Run manually: mise exec -- govulncheck ./...
}

local go_formatters = new Mapping<String, Step> {
    // Go formatting - uses builtin
    ["gofmt"] = Builtins.go_fmt

    // Go imports - uses builtin
    ["goimports"] = Builtins.go_imports
}

local quality_checks = new Mapping<String, Step> {
    // Trailing whitespace - uses builtin
    ["trailing-whitespace"] = Builtins.trailing_whitespace

    // Merge conflict markers - uses builtin
    ["check-merge-conflict"] = Builtins.check_merge_conflict

    // Private key detection - uses builtin
    ["detect-private-key"] = Builtins.detect_private_key
}

// ===============================================
// HOOKS CONFIGURATION (All commented out by default)
// ===============================================
//
// Uncomment the sections below to activate hooks.
// Then run: mise exec -- hk install
//
// ===============================================

// Pre-commit hook: Fast checks on staged files only
// Runs: secret detection, Go security, formatting, quality checks
//
hooks {
    ["pre-commit"] {
        fix = true    // Auto-fix formatting issues
        stash = "git" // Stash unstaged changes during fixes
        steps {
            ...security_linters
            ...go_formatters
            ...quality_checks
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...go_formatters
        }
    }
    ["check"] {
        steps {
            ...security_linters
            ...quality_checks
        }
    }
}

// Pre-push hook: Slower, more thorough checks
// Runs: full test suite, full git history scan for secrets

